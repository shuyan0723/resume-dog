# 复制成 .env 后填入真实值。.env 已被 .gitignore 排除，不会进仓库。
# Windows PowerShell 用 $env:VAR=value 逐个设置，Git Bash 可以直接 source .env。

# ---- 必填 ----
# Anthropic API Key：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# JWT 签名密钥，必须 >= 32 字节。生成方式：
#   openssl rand -base64 48
# 或者：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=please-generate-a-real-random-secret-at-least-32-bytes

# ---- 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=resume_dog
DB_USER=root
DB_PASSWORD=root

# ---- 可选 ----
# 改模型：claude-opus-5-5 质量最好；
# 若要压成本做规模化，claude-sonnet-5-5 是同代更便宜的档位，改这里即可，无需动代码。
CLAUDE_MODEL=claude-opus-5-5

# 设为 true 时后端不调用 Claude，直接返回示例数据。
# 第一次跑通前端流程时建议打开，省 API 额度。
CLAUDE_MOCK=false
